# AI-Augmented Smart Traffic Signal Management System
# Configuration Environment Variables

# Anthropic Claude API Key (Optional: system includes intelligent local semantic engine fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL Database Configuration (Optional: system defaults to embedded SQLite if not enabled)
USE_POSTGRES=false
PGHOST=localhost
PGPORT=5432
PGDATABASE=traffic_db
PGUSER=postgres
PGPASSWORD=postgres

# Server Port
PORT=8000
